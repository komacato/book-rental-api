{
    "swagger": "2.0",
    "info": {
        "description": "Book Rental REST API",
        "title": "Book Rental API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/books": {
            "get": {
                "description": "Get a list of all books from library",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Books"
                ],
                "summary": "Get all books",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Book"
                            }
                        }
                    }
                }
            }
        },
        "/loans": {
            "post": {
                "description": "membuat/menyimpan data peminjaman buku",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Books"
                ],
                "summary": "Create a new loan",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Loan"
                        }
                    }
                }
            }
        },
        "/users/login": {
            "post": {
                "description": "Login user yang sudah terdaftar",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "Login user",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Response berhasil login user",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseSuccessLogin"
                        }
                    },
                    "401": {
                        "description": "Failed login error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseFailedLogin"
                        }
                    }
                }
            }
        },
        "/users/profile": {
            "get": {
                "description": "Menampilkan informasi user yang sedang login",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Get user profile",
                "responses": {
                    "200": {
                        "description": "Response berhasil mendapatkan profile user",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseSuccessGetProfile"
                        }
                    },
                    "401": {
                        "description": "Failed get profile error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseFailedGetProfile"
                        }
                    },
                    "503": {
                        "description": "Response berhasil update profile user",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseSuccessUpdateProfile"
                        }
                    },
                    "504": {
                        "description": "Failed update profile error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseFailedUpdateProfile"
                        }
                    }
                }
            }
        },
        "/users/register": {
            "post": {
                "description": "Register user baru",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Register user baru",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.RegisterUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Response berhasil register user baru",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseSuccessRegister"
                        }
                    },
                    "400": {
                        "description": "Bad request error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseBadRequest"
                        }
                    },
                    "500": {
                        "description": "Internal server error; semua error lain seperti error bad request dan error not found masuk ke sini",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResponseInternalServerError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.LoginUserRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "carmen@gmail.com"
                },
                "password": {
                    "type": "string",
                    "example": "12345678"
                }
            }
        },
        "handlers.RegisterUserRequest": {
            "type": "object",
            "properties": {
                "date_of_birth": {
                    "type": "string",
                    "example": "2002-01-01"
                },
                "first_name": {
                    "type": "string",
                    "example": "Nyoman Ayu"
                },
                "last_name": {
                    "type": "string",
                    "example": "Carmenita"
                },
                "password": {
                    "type": "string",
                    "example": "12345678"
                },
                "username": {
                    "type": "string",
                    "example": "Carmen"
                }
            }
        },
        "handlers.ResponseBadRequest": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "name is required"
                }
            }
        },
        "handlers.ResponseFailedGetProfile": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Failed get profile"
                }
            }
        },
        "handlers.ResponseFailedLogin": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Failed login"
                }
            }
        },
        "handlers.ResponseFailedUpdateProfile": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Failed update profile"
                }
            }
        },
        "handlers.ResponseInternalServerError": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "string",
                    "example": "error generated from err.Error() object"
                },
                "message": {
                    "type": "string",
                    "example": "internal server error"
                }
            }
        },
        "handlers.ResponseSuccessGetProfile": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "success get profile"
                },
                "user": {
                    "type": "object",
                    "properties": {
                        "date_of_birth": {
                            "type": "string",
                            "example": "2002-01-01"
                        },
                        "first_name": {
                            "type": "string",
                            "example": "Nyoman Ayu"
                        },
                        "id": {
                            "type": "integer",
                            "example": 1
                        },
                        "last_name": {
                            "type": "string",
                            "example": "Carmenita"
                        },
                        "username": {
                            "type": "string",
                            "example": "Carmen"
                        }
                    }
                }
            }
        },
        "handlers.ResponseSuccessLogin": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "success login"
                },
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxLCJleHAiOjE2ODg4ODQ4MDB9.3n8sKZl7j8mLh0v5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5z5"
                }
            }
        },
        "handlers.ResponseSuccessRegister": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "success register"
                },
                "user": {
                    "$ref": "#/definitions/handlers.UserRegisterResponse"
                }
            }
        },
        "handlers.ResponseSuccessUpdateProfile": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "success update profile"
                },
                "user": {
                    "type": "object",
                    "properties": {
                        "date_of_birth": {
                            "type": "string",
                            "example": "2002-01-01"
                        },
                        "first_name": {
                            "type": "string",
                            "example": "Nyoman Ayu"
                        },
                        "id": {
                            "type": "integer",
                            "example": 1
                        },
                        "last_name": {
                            "type": "string",
                            "example": "Carmenita"
                        },
                        "username": {
                            "type": "string",
                            "example": "Carmen"
                        }
                    }
                }
            }
        },
        "handlers.UserRegisterResponse": {
            "type": "object",
            "properties": {
                "age": {
                    "type": "integer",
                    "example": 22
                },
                "full_name": {
                    "type": "string",
                    "example": "Nyoman Ayu Carmenita"
                },
                "username": {
                    "type": "string",
                    "example": "Carmen"
                }
            }
        },
        "models.Author": {
            "type": "object",
            "properties": {
                "firstName": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "lastName": {
                    "type": "string"
                }
            }
        },
        "models.Book": {
            "type": "object",
            "properties": {
                "author": {
                    "$ref": "#/definitions/models.Author"
                },
                "authorID": {
                    "type": "integer"
                },
                "coverURL": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "genre": {
                    "$ref": "#/definitions/models.Genre"
                },
                "genreID": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "minAgeRestriction": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "models.Genre": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.Loan": {
            "type": "object",
            "properties": {
                "book": {
                    "$ref": "#/definitions/models.Book"
                },
                "bookID": {
                    "type": "integer"
                },
                "dueDate": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "loanDate": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/models.User"
                },
                "userID": {
                    "type": "integer"
                }
            }
        },
        "models.User": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "date_of_birth": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "last_name": {
                    "type": "string"
                },
                "loans": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Loan"
                    }
                },
                "password": {
                    "type": "string"
                }
            }
        }
    }
}